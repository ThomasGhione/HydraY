/.*
.vscode
.venv
*.out
*.elf
*.o
*.d
/output/
*.log
*.png
*.csv
!auto_tuner.csv
# Built engine binaries at repo root (chess, chess_dev, chess.exe, chess_windows, ...).
# git cannot ignore "all executables" by permission bit, so anchor the build names.
/chess*
/tests/test
/tests/perf
/tests/sacrifice
/tests/tt_hugepage_bench
/games/
/saves/
/stockfish/
/engine/syzygy/files/
/cutechess/

# Local tuning artifacts
/tuning/engines.json
/tuning/log.txt
/tuning/out.pgn
/tuning/*.npz
/tuning/*.pkl
/tuning/.last_tuning_dataset
/tuning/.tuning_state/
/tuning/plots/
/tuning/chess_baseline
/tuning/chess_halfka_a3
/tuning/sprt_*.pgn
# Gauntlet artifacts: on-demand reference binaries and per-run outputs
/tuning/chess_ref_*
/tuning/gauntlet_*.pgn
/tuning/gauntlet_*.txt

# Stockfish-calibration artifacts (run_sf_calibration.sh)
/tuning/sfcal_*

# NNUE training data (datagen output, GB-sized)
/nnue/data/
/nnue/trainer/target/
# fastchess auto-generated resume configs
config.json

# Python bytecode (never track compiled caches)
__pycache__/
*.pyc

# Tuning run artefacts: SPRT/gauntlet/calibration logs and their PGNs. Hundreds
# of MB each -- GitHub rejects files over 100 MB, and they are reproducible
# output, not source. (tuning/books/openings.pgn stays tracked: it is input.)
tuning/log_*.txt
tuning/*.pgn
tuning/*.pgn.*
tuning/sfcal_*.txt
tuning/sprt_*.txt
tuning/gauntlet_*.txt
tuning/chess_baseline
