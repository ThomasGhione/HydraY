/.*
.vscode
.venv
*.out
*.elf
*.o
*.d
/output/
*.log
*.png
*.csv
!auto_tuner.csv
# Built engine binaries at repo root (chess, chess_dev, chess.exe, chess_windows, ...).
# git cannot ignore "all executables" by permission bit, so anchor the build names.
/chess*
/tests/test
/tests/perf
/tests/sacrifice
/tests/tt_hugepage_bench
/games/
/saves/
/stockfish/
/engine/syzygy/files/
/cutechess/

# Local tuning artifacts
/tuning/engines.json
/tuning/log.txt
/tuning/log_*.txt
/tuning/out.pgn
/tuning/*.pgn
/tuning/*.CONTAMINATO
/tuning/*.npz
/tuning/*.pkl
/tuning/.last_tuning_dataset
/tuning/.tuning_state/
/tuning/plots/
/tuning/chess_baseline
/tuning/chess_halfka_a3
/tuning/sprt_*.pgn
# Gauntlet and calibration (runfastchess.sh, elo_watch.sh): run state, tag
# builds and the ordo report written next to each pgn
/tuning/.elo_*
/tuning/.refs/
/tuning/*_ratings.txt
/tuning/*_h2h.txt
/tuning/*_anchors.txt
# left over by the old run_gauntlet.sh and run_sf_calibration.sh
/tuning/chess_ref_*
/tuning/gauntlet_*.txt
/tuning/sfcal_*

# NNUE training data (datagen output, GB-sized)
/nnue/data/
/nnue/trainer/target/
# fastchess auto-generated resume configs
config.json

# Python bytecode (never track compiled caches)
__pycache__/
*.pyc
